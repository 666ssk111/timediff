/* pages/idcard/idcard.wxss —— 身份证解析 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #EC4899 0%, #F472B6 100%);
  padding: 48rpx 40rpx 112rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -80rpx; position: relative; z-index: 2; }

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

.field { }
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }
.input-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
}
.id-input { flex: 1; font-size: 34rpx; letter-spacing: 2rpx; font-weight: 600; color: #1F2937; height: 96rpx; line-height: 96rpx; }
.id-ph { color: #D1D5DB; font-weight: 400; letter-spacing: 0; }
.clear-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F3F4F6;
  color: #9CA3AF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}
.clear-hover { background: #FEE2E2; color: #EF4444; }

.parse-btn {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #EC4899 0%, #F472B6 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(236, 72, 153, 0.35);
}
.parse-btn::after { border: none; }
.parse-btn-hover { opacity: 0.88; }

/* 结果 */
.result { margin-top: 24rpx; }

.status {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}
.status.ok { background: #FDE8F2; }
.status.bad { background: #FEF2F2; }
.status-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}
.status.ok .status-icon { background: #EC4899; }
.status.bad .status-icon { background: #EF4444; }
.status-text { margin-left: 16rpx; font-size: 26rpx; color: #4B5563; font-weight: 500; }

.info-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  margin-bottom: 20rpx;
}
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.info-item:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #6B7280; }
.info-value { font-size: 30rpx; font-weight: 700; color: #1F2937; }

.fun-row { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.fun-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.fun-icon { font-size: 52rpx; }
.fun-label { margin-top: 12rpx; font-size: 24rpx; color: #9CA3AF; }
.fun-value { margin-top: 6rpx; font-size: 34rpx; font-weight: 800; color: #EC4899; }

.privacy-note {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 16rpx 0;
}