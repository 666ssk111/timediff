/* pages/notify/notify.wxss —— 消息通知设置 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

/* 头部 */
.hero {
  background: linear-gradient(160deg, #4F46E5 0%, #6366F1 100%);
  padding: 48rpx 40rpx 120rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 64rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 40rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 12rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.78); line-height: 1.5; position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -80rpx; position: relative; z-index: 2; }

/* 加载 */
.loading-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 80rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.06);
}
.loading-text { font-size: 28rpx; color: #9CA3AF; }

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.06);
  margin-bottom: 24rpx;
}

/* 总开关 */
.master-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.master-info {
  display: flex;
  align-items: center;
  flex: 1;
}
.master-icon { font-size: 48rpx; margin-right: 24rpx; }
.master-text { display: flex; flex-direction: column; }
.master-title { font-size: 32rpx; font-weight: 700; color: #1F2937; }
.master-desc { margin-top: 6rpx; font-size: 24rpx; color: #9CA3AF; }

/* 分区标题 */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin: 8rpx 0 16rpx 4rpx;
}

/* 通知类型条目 */
.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.item-row.disabled { opacity: 0.5; }
.item-info {
  display: flex;
  align-items: flex-start;
  flex: 1;
  margin-right: 24rpx;
}
.item-icon { font-size: 40rpx; margin-right: 20rpx; margin-top: 2rpx; }
.item-text { display: flex; flex-direction: column; flex: 1; }
.item-title { font-size: 28rpx; font-weight: 600; color: #1F2937; }
.item-desc { margin-top: 4rpx; font-size: 22rpx; color: #9CA3AF; line-height: 1.4; }

.divider {
  height: 1rpx;
  background: #F3F4F6;
  margin: 24rpx 0;
}

.coming-soon {
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 6rpx 16rpx;
  background: #F3F4F6;
  border-radius: 20rpx;
  white-space: nowrap;
}

/* 订阅 */
.subscribe-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.subscribe-info {
  display: flex;
  align-items: flex-start;
  flex: 1;
  margin-right: 24rpx;
}
.subscribe-icon { font-size: 40rpx; margin-right: 20rpx; margin-top: 2rpx; }
.subscribe-text { display: flex; flex-direction: column; flex: 1; }
.subscribe-title { font-size: 28rpx; font-weight: 600; color: #1F2937; }
.subscribe-desc { margin-top: 4rpx; font-size: 22rpx; color: #9CA3AF; line-height: 1.4; }

.subscribe-btn {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #4F46E5;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.subscribe-btn.subscribed {
  background: #DCFCE7;
  color: #16A34A;
}

/* 提示 */
.tips-card {
  background: #FFF7ED;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 8rpx;
}
.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #EA580C;
  margin-bottom: 16rpx;
}
.tips-item {
  font-size: 24rpx;
  color: #9A3412;
  line-height: 1.8;
  padding-left: 16rpx;
  position: relative;
}
.tips-item::before {
  content: '•';
  position: absolute;
  left: 0;
  color: #EA580C;
}