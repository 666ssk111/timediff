/* pages/mine/mine.wxss —— 我的 */
.mine {
  min-height: 100vh;
  background: #F5F6FA;
  padding: 32rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.06);
  margin-bottom: 32rpx;
}

.avatar-wrapper {
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #E5E7EB;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #E5E7EB;
}

.avatar-icon {
  font-size: 60rpx;
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}

.nick-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.login-btn {
  font-size: 36rpx;
  font-weight: 700;
  color: #4F46E5;
  margin-bottom: 12rpx;
}

.edit-btn {
  font-size: 26rpx;
  color: #6B7280;
}

/* 功能列表 */
.menu-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1F2937;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C4CAD4;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  text-align: center;
  margin-bottom: 40rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
  display: block;
}

.avatar-edit {
  display: flex;
  justify-content: center;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #E5E7EB;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
}

/* 反馈 */
.feedback-wrapper {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #E2E8F0;
  transition: all 0.3s ease;
}

.feedback-input {
  width: 100%;
  min-height: 240rpx;
  background: transparent;
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.8;
  padding: 8rpx 0;
}

.feedback-placeholder {
  color: #94A3B8;
  font-size: 26rpx;
}

.feedback-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E2E8F0;
}

.feedback-count {
  font-size: 22rpx;
  color: #94A3B8;
  font-family: 'SF Mono', 'Consolas', monospace;
}

.feedback-hint {
  font-size: 22rpx;
  color: #64748B;
}

.feedback-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9CA3AF;
  text-align: center;
}

/* 弹窗按钮 */
.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.btn-confirm {
  background: #4F46E5;
  color: #FFFFFF;
}

.btn-confirm.disabled {
  opacity: 0.6;
}

/* 通知设置 */
.menu-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.menu-status.on {
  background: #DCFCE7;
  color: #16A34A;
}

.menu-status.off {
  background: #F3F4F6;
  color: #9CA3AF;
}

.notify-desc {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  margin: -20rpx 0 32rpx 0;
  line-height: 1.6;
}

.notify-input {
  min-height: 100rpx;
  padding: 16rpx 24rpx;
  line-height: 1.6;
}

.form-placeholder {
  color: #94A3B8;
  font-size: 26rpx;
}

.notify-tips {
  background: #FFF7ED;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.notify-tip-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #EA580C;
  margin-bottom: 12rpx;
}

.notify-tip-item {
  font-size: 22rpx;
  color: #9A3412;
  line-height: 1.8;
}
