/* pages/ocr/ocr.wxss —— OCR 识别与翻译 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #F59E0B 0%, #FBBF24 100%);
  padding: 48rpx 40rpx 120rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); position: relative; z-index: 1; }

/* 模式切换 */
.tab-wrap {
  display: flex;
  margin: -88rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 8rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.06);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}
.tab.active { background: #FEF3E3; color: #F59E0B; font-weight: 700; }

.body { padding: 24rpx 32rpx 0; }

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

/* 上传区域 */
.upload-area {
  height: 360rpx;
  border: 2rpx dashed #E5E7EB;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.upload-hover { background: #FFFBF2; }
.upload-icon { font-size: 80rpx; }
.upload-text { margin-top: 20rpx; font-size: 30rpx; color: #1F2937; font-weight: 600; }
.upload-sub { margin-top: 8rpx; font-size: 24rpx; color: #9CA3AF; }
.preview { width: 100%; height: 100%; }

/* 按钮 */
.primary-btn {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(245, 158, 11, 0.35);
}
.primary-btn::after { border: none; }
.btn-hover { opacity: 0.88; }

/* 字段 */
.field { margin-top: 28rpx; }
.field:first-child { margin-top: 0; }
.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }
.label-row .label { margin-bottom: 0; }
.label-hint { font-size: 22rpx; color: #D1D5DB; }

.picker {
  height: 84rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
}
.picker-text { font-size: 30rpx; color: #1F2937; font-weight: 500; }
.picker-arrow { font-size: 20rpx; color: #9CA3AF; }

.input-text {
  width: 100%;
  min-height: 200rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #1F2937;
  line-height: 1.6;
}
.ph { color: #D1D5DB; }

/* 结果区域 */
.section { margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid #F3F4F6; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #1F2937; }
.section-actions { display: flex; align-items: center; gap: 24rpx; }
.section-action { font-size: 26rpx; color: #F59E0B; font-weight: 600; }
.section-action.sep { position: relative; }
.section-action.sep::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 20rpx;
  background: #E5E7EB;
}

.result-text {
  width: 100%;
  min-height: 160rpx;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #1F2937;
  line-height: 1.6;
}
.result-box {
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 32rpx;
  color: #1F2937;
  line-height: 1.6;
  word-break: break-all;
}