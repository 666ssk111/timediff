/* pages/account/account.wxss —— 已修复 inset / @keyframes 兼容性问题 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 40rpx; }

/* 顶部 */
.hero {
  background: linear-gradient(160deg, #14B8A6 0%, #2DD4BF 100%);
  padding: 48rpx 40rpx 120rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -50rpx;
  top: -50rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -88rpx; position: relative; z-index: 2; }

/* 汇总卡片 */
.card { background: #FFFFFF; border-radius: 32rpx; box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05); }
.summary-card { padding: 32rpx 36rpx; margin-bottom: 24rpx; }

.month-nav { display: flex; align-items: center; justify-content: center; }
.nav-arrow { font-size: 44rpx; color: #9CA3AF; width: 72rpx; height: 56rpx; line-height: 56rpx; text-align: center; }
.month-text { font-size: 32rpx; font-weight: 700; color: #1F2937; margin: 0 24rpx; }

.balance-row { margin-top: 24rpx; text-align: center; }
.balance-label { font-size: 24rpx; color: #9CA3AF; }
.balance-num { margin-top: 8rpx; font-size: 56rpx; font-weight: 800; }
.balance-num.positive { color: #14B8A6; }
.balance-num.negative { color: #EF4444; }

.in-ex-row { display: flex; align-items: center; margin-top: 24rpx; padding: 20rpx 0; border-top: 1rpx solid #F3F4F6; }
.in-ex { flex: 1; text-align: center; }
.in-ex-div { width: 1rpx; height: 48rpx; background: #E5E7EB; }
.ie-label { display: block; font-size: 24rpx; color: #9CA3AF; }
.ie-num { display: block; margin-top: 6rpx; font-size: 32rpx; font-weight: 700; }
.ie-num.income { color: #14B8A6; }
.ie-num.expense { color: #EF4444; }

/* 分类占比 */
.cat-breakdown { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #F3F4F6; }
.cat-title { font-size: 24rpx; color: #9CA3AF; margin-bottom: 16rpx; }
.cat-bar { display: flex; align-items: center; margin-bottom: 14rpx; padding: 8rpx 0; border-radius: 12rpx; }
.cat-bar-hover { background: rgba(20, 184, 166, 0.06); }
.cat-name { width: 80rpx; font-size: 24rpx; color: #4B5563; flex-shrink: 0; }
.cat-track { flex: 1; height: 12rpx; background: #F3F4F6; border-radius: 6rpx; margin: 0 16rpx; overflow: hidden; }
.cat-fill { height: 100%; background: linear-gradient(90deg, #14B8A6, #2DD4BF); border-radius: 6rpx; min-width: 4rpx; }
.cat-amount { font-size: 24rpx; color: #6B7280; width: 100rpx; text-align: right; flex-shrink: 0; }

/* 列表 */
.list-header { display: flex; justify-content: space-between; align-items: center; padding: 0 8rpx 16rpx; }
.list-title { font-size: 30rpx; font-weight: 700; color: #1F2937; }
.list-count { font-size: 24rpx; color: #9CA3AF; }

/* ========== 按天分组 ========== */
.day-list { margin-bottom: 160rpx; }

.day-group { margin-bottom: 12rpx; }

/* 日期行 */
.day-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.04);
}
.day-row-hover { opacity: 0.85; }

.day-row-left { display: flex; align-items: center; }
.day-expand {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9CA3AF;
  font-weight: 700;
  margin-right: 16rpx;
  transition: transform 0.2s ease;
}
.day-expand.expanded { transform: rotate(90deg); background: #D1FAE5; color: #14B8A6; }

.day-date { font-size: 28rpx; font-weight: 600; color: #1F2937; }

.day-row-right { display: flex; gap: 20rpx; }
.day-income { font-size: 24rpx; color: #14B8A6; font-weight: 600; }
.day-expense { font-size: 24rpx; color: #EF4444; font-weight: 600; }
.day-total { font-size: 24rpx; font-weight: 700; }
.day-total.total-plus { color: #14B8A6; }
.day-total.total-minus { color: #EF4444; }

/* 展开的账单明细 */
.day-bills {
  margin-top: 8rpx;
  padding: 8rpx 0 4rpx 16rpx;
  border-left: 3rpx solid #D1FAE5;
  margin-left: 20rpx;
}

.bill {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 41, 55, 0.03);
}
.bill-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.bill-cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.cat-expense { background: #FEE2E2; color: #EF4444; }
.cat-income { background: #D1FAE5; color: #10B981; }
.bill-info { margin-left: 20rpx; flex: 1; min-width: 0; }
.bill-cat { font-size: 28rpx; color: #1F2937; font-weight: 500; }
.bill-note { display: block; margin-top: 4rpx; font-size: 24rpx; color: #9CA3AF; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bill-date { display: block; margin-top: 4rpx; font-size: 22rpx; color: #C4CAD4; }

.bill-right { display: flex; align-items: center; flex-shrink: 0; margin-left: 16rpx; }
.bill-amount { font-size: 30rpx; font-weight: 700; }
.bill-amount.income { color: #14B8A6; }
.bill-amount.expense { color: #1F2937; }
.bill-del {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D1D5DB;
  font-size: 24rpx;
  margin-left: 12rpx;
}
.bill-del-hover { background: #FEE2E2; color: #EF4444; }

/* 空状态 */
.empty { padding: 80rpx 0; text-align: center; }
.empty-icon { font-size: 80rpx; }
.empty-text { display: block; margin-top: 20rpx; font-size: 30rpx; color: #6B7280; font-weight: 600; }
.empty-sub { display: block; margin-top: 8rpx; font-size: 26rpx; color: #9CA3AF; }

/* 新增面板（inset 替换为显式定位，动画改为 transition） */
.add-panel { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; }
.panel-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, 0.4); }
.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 36rpx 60rpx;
}
.panel-header { display: flex; justify-content: space-between; align-items: center; }
.panel-title { font-size: 34rpx; font-weight: 700; color: #1F2937; }
.panel-close { font-size: 32rpx; color: #D1D5DB; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; }

/* 类型 */
.type-row { display: flex; margin-top: 28rpx; }
.type-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 20rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 20rpx;
}
.type-btn:last-child { margin-right: 0; }
.type-btn.active.expense { background: #FEE2E2; color: #EF4444; font-weight: 700; }
.type-btn.active.income { background: #D1FAE5; color: #10B981; font-weight: 700; }

/* 金额 */
.amount-input {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}
.ai-currency { font-size: 48rpx; font-weight: 700; color: #1F2937; margin-right: 8rpx; }
.ai-input { font-size: 56rpx; font-weight: 800; color: #1F2937; text-align: center; width: 400rpx; }
.ai-ph { color: #D1D5DB; font-weight: 400; }

.field { margin-top: 28rpx; }
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }
.picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #1F2937;
}
.note-input {
  height: 80rpx;
  padding: 0 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #1F2937;
}
.note-ph { color: #D1D5DB; }

.date-display {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #F0FDFA;
  border: 1rpx solid #99F6E4;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #0F766E;
  font-weight: 600;
  position: relative;
}
.date-display::after {
  content: '>';
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #5EEAD4;
  font-weight: 400;
}

.save-btn {
  margin-top: 36rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #14B8A6 0%, #2DD4BF 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
}
.save-btn::after { border: none; }
.save-btn-hover { opacity: 0.88; }

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #14B8A6 0%, #2DD4BF 100%);
  box-shadow: 0 12rpx 36rpx rgba(20, 184, 166, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.fab-icon { font-size: 52rpx; color: #FFFFFF; font-weight: 300; }
.fab-hover { opacity: 0.88; }