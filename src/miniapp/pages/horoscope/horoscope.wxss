/* pages/horoscope/horoscope.wxss —— 星座运势 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #1E1B4B 0%, #312E81 50%, #4C1D95 100%);
  padding: 48rpx 40rpx 96rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.star { position: absolute; color: rgba(255, 255, 255, 0.6); }
.star1 { top: 60rpx; right: 80rpx; font-size: 40rpx; }
.star2 { top: 140rpx; right: 200rpx; font-size: 24rpx; }
.star3 { top: 200rpx; right: 120rpx; font-size: 32rpx; }
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.8); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -60rpx; position: relative; z-index: 2; }

/* 星座选择 */
.sign-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.06);
  margin-bottom: 24rpx;
}
.sign {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 18rpx;
}
.sign.active { background: #EEF0FE; }
.sign-icon { font-size: 40rpx; }
.sign-name { margin-top: 6rpx; font-size: 22rpx; color: #6B7280; }
.sign.active .sign-name { color: #6366F1; font-weight: 700; }

/* 日期选择 */
.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.06);
  margin-bottom: 24rpx;
}
.date-info { display: flex; flex-direction: column; }
.date-label { font-size: 28rpx; font-weight: 700; color: #1F2937; }
.date-hint { margin-top: 6rpx; font-size: 22rpx; color: #9CA3AF; }
.date-picker {
  padding: 12rpx 28rpx;
  background: #EEF0FE;
  color: #6366F1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.date-arrow { font-size: 22rpx; }

/* 幸运卡 */
.lucky-card {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  border-radius: 32rpx;
  padding: 36rpx;
  color: #FFFFFF;
  box-shadow: 0 12rpx 30rpx rgba(99, 102, 241, 0.35);
  margin-bottom: 24rpx;
}
.lucky-head { display: flex; align-items: center; }
.lucky-icon { font-size: 64rpx; }
.lucky-title { margin-left: 20rpx; display: flex; flex-direction: column; }
.lucky-sign { font-size: 34rpx; font-weight: 700; }
.lucky-date { margin-top: 4rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.8); }
.lucky-summary { margin-top: 20rpx; font-size: 28rpx; line-height: 1.6; color: rgba(255, 255, 255, 0.95); }
.lucky-row { display: flex; align-items: center; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.2); }
.lucky-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.li-label { font-size: 22rpx; color: rgba(255, 255, 255, 0.75); }
.li-value { margin-top: 6rpx; font-size: 32rpx; font-weight: 700; }
.lucky-divider { width: 1rpx; height: 48rpx; background: rgba(255, 255, 255, 0.25); }

/* 评分 */
.score-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  margin-bottom: 24rpx;
}
.score-title { font-size: 28rpx; font-weight: 700; color: #1F2937; margin-bottom: 20rpx; }
.dim { display: flex; align-items: center; margin-bottom: 20rpx; }
.dim:last-child { margin-bottom: 0; }
.dim-icon { font-size: 28rpx; width: 48rpx; }
.dim-label { width: 80rpx; font-size: 26rpx; color: #4B5563; }
.dim-track { flex: 1; height: 14rpx; background: #F3F4F6; border-radius: 7rpx; overflow: hidden; margin: 0 20rpx; }
.dim-fill { height: 100%; background: linear-gradient(90deg, #6366F1, #A78BFA); border-radius: 7rpx; }
.dim-num { width: 60rpx; text-align: right; font-size: 26rpx; font-weight: 700; color: #6366F1; }

/* 解读 */
.detail-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.detail-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.detail-row:last-child { border-bottom: none; }
.detail-label { width: 140rpx; font-size: 26rpx; color: #4B5563; font-weight: 600; flex-shrink: 0; }
.detail-text { flex: 1; font-size: 26rpx; color: #6B7280; line-height: 1.6; }
