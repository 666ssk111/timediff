/* pages/avatar/avatar.wxss —— 壁纸头像 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #8B5CF6 0%, #A78BFA 100%);
  padding: 48rpx 40rpx 104rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after { content: ''; position: absolute; right: -40rpx; top: -40rpx; width: 200rpx; height: 200rpx; border-radius: 50%; background: rgba(255,255,255,0.08); }
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255,255,255,0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -72rpx; position: relative; z-index: 2; }
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 16rpx; }

/* 模板 */
.tpl-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.tpl {
  width: 31%;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  padding: 12rpx;
  border: 3rpx solid transparent;
}
.tpl.active { border-color: #8B5CF6; background: #F1ECFE; }
.tpl-preview { height: 140rpx; border-radius: 16rpx; }
.tpl-name {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4B5563;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tpl.active .tpl-name { color: #8B5CF6; font-weight: 700; }

.quote-input {
  height: 88rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
}
.ph { color: #D1D5DB; }

.primary-btn, .save-btn {
  margin-top: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(139, 92, 246, 0.35);
}
.primary-btn::after, .save-btn::after { border: none; }
.btn-hover { opacity: 0.88; }

.result { margin-top: 24rpx; }
.preview {
  width: 100%;
  height: 1000rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.08);
}
/* 字体选择器 */
.picker {
  height: 84rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
}
.picker-text { font-size: 30rpx; color: #1F2937; font-weight: 500; }
.picker-arrow { font-size: 20rpx; color: #9CA3AF; }

.save-btn { margin-top: 20rpx; }
