/* pages/index/index.wxss —— 工具箱首页（固定不可滑动） */
.home {
  position: relative;
  height: 100vh;
  background: linear-gradient(180deg, #3730A3 0%, #4F46E5 60rpx, #7C3AED 140rpx, #C084FC 200rpx, #F5F6FA 310rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部渐变区域 F5F6FA*/
.hero {
  position: relative;
  z-index: 1;
  overflow: hidden;
  padding: 20rpx 40rpx 36rpx;
  background: linear-gradient(160deg, #3730A3 0%, #4F46E5 30%, #7C3AED 60%, #C084FC 100%);
  border-radius: 0 0 36rpx 36rpx;
  flex-shrink: 0;
}

/* 装饰光斑 */
.hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero::before {
  content: '';
  position: absolute;
  left: 60rpx;
  bottom: -80rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.hero-row {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-sub {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* 分区 */
.section {
  flex-shrink: 0;
}

.section-fun {
  /* 小游戏区域可以稍微多占一点空间 */
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 40rpx 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #4F46E5, #A855F7);
}

.section-count {
  font-size: 22rpx;
  color: #9CA3AF;
  padding-right: 8rpx;
}

/* ========== 水平滚动容器 ========== */
.scroll-row {
  width: 100%;
  white-space: nowrap;
}

.scroll-inner {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-content: flex-start;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 实用工具：2 排 */
.scroll-practical {
  height: 360rpx;
}

/* 趣味小游戏：3 排 */
.scroll-fun {
  height: 520rpx;
}

/* ========== 实用工具卡片 ========== */
.cell {
  width: 156rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 0 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(31, 41, 55, 0.04);
  transition: transform 0.15s ease;
}

.cell-hover {
  transform: scale(0.94);
  opacity: 0.9;
}

.cell-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.cell-name {
  font-size: 22rpx;
  color: #1F2937;
  font-weight: 500;
}

/* ========== 趣味小游戏卡片 ========== */
.fun-card {
  width: 370rpx;
  height: 150rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  flex-shrink: 0;
  white-space: normal;
  box-shadow: 0 8rpx 20rpx rgba(31, 41, 55, 0.06);
  transition: transform 0.15s ease;
}

.fun-card-hover {
  transform: scale(0.96);
  opacity: 0.9;
}

.fun-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.fun-body {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.fun-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fun-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.5;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.fun-arrow {
  font-size: 32rpx;
  color: #D1D5DB;
  flex-shrink: 0;
  margin-left: 4rpx;
}

.footer-tip {
  padding: 12rpx 0 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #C4CAD4;
  flex-shrink: 0;
}