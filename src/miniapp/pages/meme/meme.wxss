/* pages/meme/meme.wxss —— 表情包生成器 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #F59E0B 0%, #FBBF24 100%);
  padding: 48rpx 40rpx 104rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after { content: ''; position: absolute; right: -40rpx; top: -40rpx; width: 200rpx; height: 200rpx; border-radius: 50%; background: rgba(255,255,255,0.08); }
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255,255,255,0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -72rpx; position: relative; z-index: 2; }
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

.upload-area {
  height: 360rpx;
  border: 2rpx dashed #E5E7EB;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-hover { background: #FFFBF2; }
.preview { width: 100%; height: 100%; }
.upload-placeholder { display: flex; flex-direction: column; align-items: center; }
.upload-icon { font-size: 80rpx; }
.upload-text { margin-top: 16rpx; font-size: 28rpx; color: #9CA3AF; }

.field { margin-top: 28rpx; }
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }
.text-input {
  height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
}
.ph { color: #D1D5DB; }

.primary-btn, .save-btn {
  margin-top: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(245, 158, 11, 0.35);
}
.primary-btn::after, .save-btn::after { border: none; }
.btn-hover { opacity: 0.88; }

.result { margin-top: 24rpx; }
.result .preview {
  width: 100%;
  height: 800rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.08);
}
.save-btn { margin-top: 20rpx; }

.share-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
}
