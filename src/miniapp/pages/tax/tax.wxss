/* pages/tax/tax.wxss */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #10B981 0%, #34D399 100%);
  padding: 48rpx 40rpx 104rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -72rpx; position: relative; z-index: 2; }

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.card-title { font-size: 32rpx; font-weight: 700; color: #1F2937; }
.card-sub { margin-top: 8rpx; font-size: 24rpx; color: #9CA3AF; }

/* 输入 */
.field { margin-top: 28rpx; }
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }
.input-wrap {
  display: flex;
  align-items: center;
  height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 20rpx;
}
.unit { font-size: 28rpx; color: #9CA3AF; margin-right: 8rpx; }
.input { flex: 1; font-size: 32rpx; font-weight: 600; color: #1F2937; height: 84rpx; line-height: 84rpx; }
.input-simple {
  height: 84rpx;
  line-height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}
.in-ph { color: #D1D5DB; font-weight: 400; }

/* 月份 */
.month-row { display: flex; gap: 16rpx; }
.month-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #F3F4F6;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}
.month-btn.active {
  background: #10B981;
  color: #FFFFFF;
  font-weight: 700;
}

/* 专项扣除 */
.deduction-list { margin-top: 24rpx; }
.deduction-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.deduction-item:last-child { border-bottom: none; }
.ded-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  flex-shrink: 0;
}
.deduction-item.checked .ded-check {
  background: #10B981;
  border-color: #10B981;
}
.ded-body { margin-left: 20rpx; flex: 1; }
.ded-name { font-size: 28rpx; color: #1F2937; font-weight: 500; }
.ded-desc { display: block; margin-top: 4rpx; font-size: 24rpx; color: #9CA3AF; }

/* 按钮 */
.calc-btn {
  margin-top: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #10B981 0%, #34D399 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(16, 185, 129, 0.35);
}
.calc-btn::after { border: none; }
.calc-btn-hover { opacity: 0.88; }

/* 结果 */
.result { margin-top: 24rpx; }
.r-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.r-label { font-size: 26rpx; color: #6B7280; }
.r-value { margin-top: 12rpx; display: flex; align-items: baseline; justify-content: center; }
.r-currency { font-size: 32rpx; color: #10B981; font-weight: 700; }
.r-num { font-size: 64rpx; font-weight: 800; color: #10B981; margin-left: 4rpx; }

.stats {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 28rpx; font-weight: 700; color: #1F2937; }
.stat-label { display: block; margin-top: 4rpx; font-size: 22rpx; color: #9CA3AF; }
.stat-div { width: 1rpx; height: 48rpx; background: #E5E7EB; }

.detail {
  margin-top: 12rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  font-size: 26rpx;
  color: #6B7280;
}
.detail-row:last-child { border-bottom: none; }
.detail-val { font-weight: 600; color: #1F2937; }
.detail-val.rate { color: #10B981; font-size: 30rpx; }