/* pages/starpop/starpop.wxss */
.page-container { position: relative; height: 100vh; overflow: hidden; background: #0a0a1a; }
.page { height: 100vh; overflow-y: auto; -webkit-overflow-scrolling: touch; }

.hero {
  background: linear-gradient(160deg, #1a0533 0%, #2d1b69 50%, #4c1d95 100%);
  padding: 36rpx 40rpx 72rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: ''; position: absolute; right: -20rpx; top: -20rpx;
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: rgba(255,255,255,0.04);
}
.hero::before {
  content: ''; position: absolute; left: 60rpx; bottom: 20rpx;
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(255,255,255,0.03);
}
.hero-icon { font-size: 48rpx; margin-bottom: 12rpx; position: relative; z-index: 1; }
.hero-title { font-size: 40rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 8rpx; font-size: 23rpx; color: rgba(255,255,255,0.7); position: relative; z-index: 1; }

.info-panel {
  display: flex; align-items: center; justify-content: space-between;
  margin: -40rpx 32rpx 0;
  background: linear-gradient(135deg, #1e1b4b 0%, #2d1b69 100%);
  border-radius: 20rpx; padding: 24rpx 28rpx;
  position: relative; z-index: 2;
  border: 1rpx solid rgba(139,92,246,0.3);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}
.info-left { display: flex; align-items: center; flex: 1; }
.level-badge {
  background: linear-gradient(135deg, #7C3AED, #A78BFA);
  color: #FFF; font-size: 22rpx; font-weight: 700;
  padding: 6rpx 16rpx; border-radius: 999rpx;
  margin-right: 16rpx; white-space: nowrap;
}
.level-name { font-size: 26rpx; color: #C4B5FD; font-weight: 600; }
.info-right { display: flex; gap: 32rpx; }
.score-row { display: flex; flex-direction: column; align-items: center; }
.score-label { font-size: 20rpx; color: #A5B4FC; }
.score-num { font-size: 32rpx; font-weight: 800; color: #E0E7FF; }
.score-num.total { color: #FBBF24; font-size: 28rpx; }

.timer-bar {
  position: relative; height: 36rpx;
  margin: 20rpx 32rpx 0;
  background: #1a1a2e; border-radius: 18rpx; overflow: hidden;
  border: 1rpx solid rgba(139,92,246,0.2);
}
.timer-fill {
  height: 100%; border-radius: 18rpx;
  background: linear-gradient(90deg, #7C3AED, #A78BFA);
  transition: width 1s linear;
}
.timer-fill.warn { background: linear-gradient(90deg, #EF4444, #F87171); }
.timer-text {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
}
.timer-icon { font-size: 22rpx; }
.timer-num { font-size: 24rpx; font-weight: 700; color: #E0E7FF; }
.timer-num.warn-text { color: #FCA5A5; }

.canvas-wrap {
  margin: 20rpx auto 0;
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: #0f0f23;
  border: 1rpx solid rgba(139,92,246,0.2);
}
.game-canvas { display: block; }

/* 游戏结束占位 */
.result-placeholder {
  margin: 20rpx auto 0;
  width: 100%;
  aspect-ratio: 1;
  background: #0f0f23;
  border: 1rpx solid rgba(139,92,246,0.2);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.rp-icon { font-size: 80rpx; }
.rp-title { font-size: 32rpx; font-weight: 700; color: #C4B5FD; }
.rp-stats { display: flex; gap: 48rpx; }
.rp-stat { display: flex; flex-direction: column; align-items: center; }
.rp-label { font-size: 22rpx; color: #A5B4FC; }
.rp-value { font-size: 44rpx; font-weight: 800; color: #E0E7FF; }
.rp-value.gold { color: #FBBF24; }

.combo-text {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0);
  font-size: 52rpx; font-weight: 800; color: #FBBF24;
  text-shadow: 0 0 24rpx rgba(251,191,36,0.7), 0 0 8rpx rgba(251,191,36,0.4);
  transition: transform 0.3s cubic-bezier(0.175,0.885,0.32,1.275);
  pointer-events: none; z-index: 5;
}
.combo-text.show { transform: translate(-50%, -50%) scale(1); }

.bottom-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 20rpx 32rpx 0;
  padding: 20rpx 28rpx;
  background: #1a1a2e; border-radius: 20rpx;
  border: 1rpx solid rgba(139,92,246,0.2);
}
.stars-remaining { display: flex; align-items: center; gap: 10rpx; }
.sr-icon { font-size: 32rpx; color: #FBBF24; }
.sr-text { font-size: 26rpx; color: #A5B4FC; font-weight: 600; }
.btn-restart {
  padding: 14rpx 24rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #7C3AED, #A78BFA);
  color: #FFF; font-size: 24rpx; font-weight: 700;
}
.btn-select-level {
  padding: 14rpx 24rpx; border-radius: 999rpx;
  background: rgba(139,92,246,0.15); color: #A78BFA;
  font-size: 24rpx; font-weight: 600;
  border: 1rpx solid rgba(139,92,246,0.3);
}

/* 弹窗 */
.overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999;
  background: rgba(5,5,20,0.85);
  display: flex; align-items: center; justify-content: center;
}
.overlay-card {
  width: 560rpx;
  background: linear-gradient(160deg, #1e1b4b 0%, #1a1a2e 100%);
  border: 1rpx solid rgba(139,92,246,0.3);
  border-radius: 32rpx; padding: 48rpx 40rpx 40rpx;
  text-align: center; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,0.5);
}
.overlay-icon { font-size: 72rpx; margin-bottom: 12rpx; }
.overlay-title { font-size: 36rpx; font-weight: 700; color: #E0E7FF; }
.overlay-level { font-size: 26rpx; color: #A78BFA; margin-top: 8rpx; }
.overlay-desc { font-size: 26rpx; color: #9CA3AF; margin-top: 8rpx; }
.overlay-divider {
  width: 100%; height: 1rpx;
  background: rgba(139,92,246,0.2); margin: 24rpx 0;
}
.overlay-stats { display: flex; justify-content: center; gap: 48rpx; margin-bottom: 20rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-label { font-size: 22rpx; color: #A5B4FC; margin-bottom: 4rpx; }
.stat-value { font-size: 44rpx; font-weight: 800; color: #E0E7FF; }
.stat-value.gold { color: #FBBF24; }
.overlay-prompt {
  font-size: 26rpx; color: #C4B5FD; font-weight: 500;
  margin-bottom: 20rpx;
}
.overlay-btns { display: flex; gap: 20rpx; width: 100%; flex-wrap: wrap; }
.overlay-btn {
  flex: 1; min-width: 200rpx; padding: 22rpx 0; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 700; text-align: center;
}
.overlay-btn.primary { background: linear-gradient(135deg, #7C3AED, #A78BFA); color: #FFF; }
.overlay-btn.secondary {
  background: rgba(139,92,246,0.15); color: #A78BFA;
  border: 1rpx solid rgba(139,92,246,0.3);
}

/* 关卡选择面板 */
.level-select-card {
  width: 640rpx;
  background: linear-gradient(160deg, #1e1b4b 0%, #1a1a2e 100%);
  border: 1rpx solid rgba(139,92,246,0.3);
  border-radius: 32rpx; padding: 40rpx 32rpx 32rpx;
  text-align: center;
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,0.5);
}
.ls-title { font-size: 36rpx; font-weight: 700; color: #E0E7FF; }
.ls-desc { display: block; font-size: 24rpx; color: #9CA3AF; margin-top: 8rpx; margin-bottom: 28rpx; }
.ls-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.ls-item {
  background: rgba(139,92,246,0.1);
  border: 1rpx solid rgba(139,92,246,0.2);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.ls-item.active {
  background: rgba(124,58,237,0.3);
  border-color: #A78BFA;
}
.ls-item.locked {
  opacity: 0.35;
  pointer-events: none;
}
.ls-lock {
  font-size: 24rpx;
  margin-bottom: 2rpx;
}
.ls-num {
  font-size: 36rpx; font-weight: 800;
  color: #C4B5FD;
}
.ls-item.active .ls-num { color: #FBBF24; }
.ls-name {
  font-size: 18rpx; color: #9CA3AF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}