/* pages/mortgage/mortgage.wxss —— 房贷计算器 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #6366F1 0%, #8B5CF6 100%);
  padding: 48rpx 40rpx 104rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -72rpx; position: relative; z-index: 2; }

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

.field { margin-top: 28rpx; }
.field:first-child { margin-top: 0; }
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }
.input-wrap {
  display: flex;
  align-items: center;
  height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
}
.input { flex: 1; font-size: 32rpx; font-weight: 600; color: #1F2937; height: 84rpx; line-height: 84rpx; }
.unit { font-size: 28rpx; color: #9CA3AF; margin-left: 8rpx; }
.input-simple {
  height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}
.in-ph { color: #D1D5DB; font-weight: 400; }

.picker {
  height: 84rpx;
  line-height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

/* 还款方式 */
.method-row { display: flex; }
.method-btn {
  flex: 1;
  border: 2rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  background: #FFFFFF;
  margin-right: 20rpx;
}
.method-btn:last-child { margin-right: 0; }
.method-btn.active { border-color: #6366F1; background: #EEF0FE; }
.method-name { display: block; font-size: 28rpx; font-weight: 600; color: #1F2937; }
.method-desc { display: block; margin-top: 4rpx; font-size: 22rpx; color: #9CA3AF; }
.method-btn.active .method-name { color: #6366F1; }

/* 按钮 */
.calc-btn {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(99, 102, 241, 0.35);
}
.calc-btn::after { border: none; }
.calc-btn-hover { opacity: 0.88; }

/* 结果 */
.result { margin-top: 24rpx; }
.r-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.r-tag {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: #EEF0FE;
  color: #6366F1;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.r-label { display: block; font-size: 26rpx; color: #6B7280; }
.r-value { margin-top: 12rpx; display: flex; align-items: baseline; justify-content: center; }
.r-currency { font-size: 32rpx; color: #6366F1; font-weight: 700; }
.r-num { font-size: 64rpx; font-weight: 800; color: #6366F1; margin-left: 4rpx; }
.r-last { display: block; margin-top: 12rpx; font-size: 24rpx; color: #9CA3AF; }

.stats {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 30rpx; font-weight: 700; color: #1F2937; }
.stat-label { display: block; margin-top: 4rpx; font-size: 22rpx; color: #9CA3AF; }
.stat-div { width: 1rpx; height: 48rpx; background: #E5E7EB; }

/* 逐月明细 */
.detail-card {
  margin-top: 12rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.detail-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 600;
}
.toggle-arrow { font-size: 24rpx; color: #6366F1; }

.schedule { border-top: 1rpx solid #F3F4F6; padding: 12rpx 0 24rpx; }
.schedule-head {
  display: flex;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: #9CA3AF;
  border-bottom: 1rpx solid #F3F4F6;
}
.schedule-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #4B5563;
  border-bottom: 1rpx solid #FAFAFC;
}
.schedule-row:last-child { border-bottom: none; }
.col { flex: 1; }
.col-m { flex: 0 0 72rpx; }