/* pages/random/random.wxss —— 随机决定 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #EC4899 0%, #F472B6 100%);
  padding: 48rpx 40rpx 104rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after { content: ''; position: absolute; right: -40rpx; top: -40rpx; width: 200rpx; height: 200rpx; border-radius: 50%; background: rgba(255,255,255,0.08); }
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255,255,255,0.82); position: relative; z-index: 1; }

/* 标签 */
.tab-wrap {
  display: flex;
  margin: -72rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 8rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.06);
}
.tab { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 999rpx; font-size: 26rpx; color: #6B7280; font-weight: 500; }
.tab.active { background: #FDE8F2; color: #EC4899; font-weight: 700; }

.body { padding: 24rpx 32rpx 0; }
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

/* 硬币 */
.coin-card { display: flex; flex-direction: column; align-items: center; padding: 60rpx 36rpx; }
.coin {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #FDE68A, #F59E0B);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(245, 158, 11, 0.4);
}
.coin.flipping { animation: flip 0.9s ease-in-out; }
@keyframes flip {
  0% { transform: rotateY(0deg); }
  50% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}
.coin-text { font-size: 80rpx; font-weight: 800; color: #FFFFFF; }
.coin-result { margin-top: 32rpx; font-size: 32rpx; font-weight: 700; color: #1F2937; }

/* 转盘/抽签公共 */
.field-row { display: flex; align-items: center; justify-content: space-between; }
.field-label { font-size: 26rpx; color: #6B7280; }

/* 导入按钮 */
.import-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #FDE8F2;
  color: #EC4899;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #F9A8D4;
}
.import-btn.importing { opacity: 0.5; }
.import-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.5;
}

.options-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 12rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1F2937;
}
.ph { color: #D1D5DB; }
.option-chips { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.chip {
  padding: 8rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  background: #FDE8F2;
  color: #EC4899;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.primary-btn {
  margin-top: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #EC4899 0%, #F472B6 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(236, 72, 153, 0.35);
}
.primary-btn::after { border: none; }
.btn-hover { opacity: 0.88; }

.spin-result { margin-top: 28rpx; text-align: center; }
.sr-label { display: block; font-size: 24rpx; color: #9CA3AF; }
.sr-value { display: block; margin-top: 8rpx; font-size: 48rpx; font-weight: 800; color: #EC4899; }

/* 抽签数量 */
.count-row { display: flex; align-items: center; justify-content: center; margin-top: 16rpx; }
.count-btn {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  background: #F3F4F6; color: #EC4899; font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
}
.count-num { font-size: 44rpx; font-weight: 800; color: #1F2937; margin: 0 40rpx; }

.lot-results { display: flex; flex-wrap: wrap; margin-top: 28rpx; }
.lot-item {
  padding: 14rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  background: #FDE8F2;
  color: #EC4899;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}
