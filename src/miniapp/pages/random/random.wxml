<!-- pages/random/random.wxml -->
<view class="page">
  <view class="hero">
    <view class="hero-icon">🎲</view>
    <view class="hero-title">随机决定</view>
    <view class="hero-desc">抛硬币 · 转盘 · 抽签，帮你做决定</view>
  </view>

  <!-- 标签切换 -->
  <view class="tab-wrap">
    <view class="tab {{tab === 0 ? 'active' : ''}}" data-tab="0" bindtap="onTab">🪙 抛硬币</view>
    <view class="tab {{tab === 1 ? 'active' : ''}}" data-tab="1" bindtap="onTab">🎯 转盘</view>
    <view class="tab {{tab === 2 ? 'active' : ''}}" data-tab="2" bindtap="onTab">🎟️ 抽签</view>
  </view>

  <!-- 抛硬币 -->
  <view class="body" wx:if="{{tab === 0}}">
    <view class="card coin-card">
      <view class="coin {{flipping ? 'flipping' : ''}}" bindtap="flipCoin">
        <text class="coin-text">{{coinResult ? (coinResult === '正面' ? '正' : '反') : '抛'}}</text>
      </view>
      <text class="coin-result">{{coinResult || '点击硬币开始'}}</text>
    </view>
  </view>

  <!-- 转盘 -->
  <view class="body" wx:elif="{{tab === 1}}">
    <view class="card">
      <view class="field-row">
        <text class="field-label">选项（逗号或换行分隔）</text>
        <view class="import-btn {{importing ? 'importing' : ''}}" bindtap="onImportFile">
          <text>📎 {{importing ? '解析中...' : '导入文档'}}</text>
        </view>
      </view>
      <textarea class="options-input" value="{{optionsText}}" bindinput="onOptionsInput"
                placeholder="如：火锅,烧烤,日料,面食" placeholder-class="ph" />
      <view class="import-hint" wx:if="{{importName}}">
        <text>📄 已导入：{{importName}}（{{options.length}} 个选项）</text>
      </view>
      <view class="import-hint" wx:else>
        <text>💡 支持导入 Excel / Word 文档，内容需用逗号或换行分隔</text>
      </view>
      <view class="option-chips">
        <view class="chip" wx:for="{{options}}" wx:key="index">{{item}}</view>
      </view>
      <button class="primary-btn" bindtap="spin" hover-class="btn-hover">转动转盘</button>
      <view class="spin-result" wx:if="{{spinResult}}">
        <text class="sr-label">选中</text>
        <text class="sr-value">{{spinResult}}</text>
      </view>
    </view>
  </view>

  <!-- 抽签 -->
  <view class="body" wx:else>
    <view class="card">
      <view class="field-row">
        <text class="field-label">候选名单（逗号或换行分隔）</text>
        <view class="import-btn {{importing ? 'importing' : ''}}" bindtap="onImportFile">
          <text>📎 {{importing ? '解析中...' : '导入文档'}}</text>
        </view>
      </view>
      <textarea class="options-input" value="{{optionsText}}" bindinput="onOptionsInput"
                placeholder="如：小红,小明,小刚" placeholder-class="ph" />
      <view class="import-hint" wx:if="{{importName}}">
        <text>📄 已导入：{{importName}}（{{options.length}} 个选项）</text>
      </view>
      <view class="import-hint" wx:else>
        <text>💡 支持导入 Excel / Word 文档，内容需用逗号或换行分隔</text>
      </view>
      <view class="field-label" style="margin-top: 28rpx;">抽取数量</view>
      <view class="count-row">
        <view class="count-btn" bindtap="decCount">−</view>
        <text class="count-num">{{lotCount}}</text>
        <view class="count-btn" bindtap="incCount">＋</view>
      </view>
      <button class="primary-btn" bindtap="drawLot" hover-class="btn-hover">开始抽签</button>
      <view class="lot-results" wx:if="{{lotResults.length > 0}}">
        <view class="lot-item" wx:for="{{lotResults}}" wx:key="index">{{item}}</view>
      </view>
    </view>
  </view>
</view>