<!-- pages/base/base.wxml —— 进制转换 -->
<view class="page">
  <view class="hero">
    <view class="hero-icon">🔢</view>
    <view class="hero-title">进制转换</view>
    <view class="hero-desc">2 ~ 36 进制任意互转，支持超大整数</view>
  </view>

  <view class="body">
    <view class="card">
      <view class="field">
        <text class="label">输入数值</text>
        <input class="value-input" placeholder="请输入数值" placeholder-class="value-ph"
               value="{{value}}" bindinput="onValueInput" />
      </view>

      <view class="field">
        <text class="label">源进制</text>
        <picker mode="selector" range="{{bases}}" range-key="name" value="{{fromIndex}}" bindchange="onFromChange">
          <view class="picker">{{bases[fromIndex].name}}</view>
        </picker>
      </view>

      <view class="swap-btn" bindtap="swap" hover-class="swap-hover">⇅ 交换</view>

      <view class="field">
        <text class="label">目标进制</text>
        <picker mode="selector" range="{{bases}}" range-key="name" value="{{toIndex}}" bindchange="onToChange">
          <view class="picker">{{bases[toIndex].name}}</view>
        </picker>
      </view>
    </view>

    <button class="calc-btn" bindtap="convert" hover-class="calc-btn-hover">开始转换</button>

    <!-- 结果 -->
    <view class="result" wx:if="{{result}}">
      <view class="r-card">
        <text class="r-label">转换结果（{{result.toBase}} 进制）</text>
        <view class="r-num">{{result.targetStr}}</view>
      </view>

      <view class="common-title">常用进制对照</view>
      <view class="common-grid">
        <view class="common-item">
          <text class="ci-label">十进制</text>
          <text class="ci-value">{{result.decimalStr}}</text>
        </view>
        <view class="common-item">
          <text class="ci-label">二进制</text>
          <text class="ci-value">{{result.binaryStr}}</text>
        </view>
        <view class="common-item">
          <text class="ci-label">八进制</text>
          <text class="ci-value">{{result.octalStr}}</text>
        </view>
        <view class="common-item">
          <text class="ci-label">十六进制</text>
          <text class="ci-value">{{result.hexStr}}</text>
        </view>
      </view>
    </view>
  </view>
</view>