/* pages/base/base.wxss —— 进制转换 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #64748B 0%, #94A3B8 100%);
  padding: 48rpx 40rpx 112rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -80rpx; position: relative; z-index: 2; }

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

.field { margin-bottom: 28rpx; }
.field:last-child { margin-bottom: 0; }
.label { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 12rpx; }
.value-input {
  height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}
.value-ph { color: #D1D5DB; font-weight: 400; }
.picker {
  height: 84rpx;
  line-height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.swap-btn {
  margin: 8rpx 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #EDF0F4;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #64748B;
  font-weight: 600;
}
.swap-hover { opacity: 0.8; }

.calc-btn {
  margin-top: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #64748B 0%, #94A3B8 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(100, 116, 139, 0.35);
}
.calc-btn::after { border: none; }
.calc-btn-hover { opacity: 0.88; }

/* 结果 */
.result { margin-top: 28rpx; }
.r-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.r-label { font-size: 24rpx; color: #9CA3AF; }
.r-num {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #64748B;
  word-break: break-all;
  line-height: 1.4;
}

.common-title { margin: 28rpx 8rpx 16rpx; font-size: 28rpx; font-weight: 700; color: #1F2937; }
.common-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.common-item {
  width: 48%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 41, 55, 0.04);
}
.ci-label { display: block; font-size: 22rpx; color: #9CA3AF; }
.ci-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2937;
  word-break: break-all;
  line-height: 1.4;
}