/* pages/game2048/game2048.wxss —— 2048 */
.page { height: 100vh; background: #FAF8EF; display: flex; flex-direction: column; }

/* 头部 */
.hero {
  background: linear-gradient(160deg, #F59E0B 0%, #FBBF24 100%);
  padding: 36rpx 40rpx 40rpx;
  color: #FFFFFF;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.hero-left { flex: 1; }
.hero-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.hero-title { font-size: 48rpx; font-weight: 800; }
.hero-desc { margin-top: 6rpx; font-size: 24rpx; color: rgba(255,255,255,0.8); }
.hero-right { display: flex; gap: 16rpx; }
.score-box {
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  text-align: center;
  min-width: 100rpx;
}
.score-label { font-size: 22rpx; color: rgba(255,255,255,0.75); display: block; }
.score-value { font-size: 36rpx; font-weight: 800; display: block; margin-top: 2rpx; }

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}
.toolbar-tip { font-size: 24rpx; color: #B8A99A; }
.toolbar-btn {
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  background: #8F7A66;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

/* 游戏面板 */
.board-wrap {
  margin: 0 32rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.board {
  width: 100%;
  aspect-ratio: 1;
  background: #BBADA0;
  border-radius: 16rpx;
  padding: 12rpx;
  box-sizing: border-box;
}
.board-grid {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, 1fr);
  gap: 12rpx;
}

/* 格子 */
.cell {
  position: relative;
  border-radius: 8rpx;
}
.cell-bg {
  width: 100%;
  height: 100%;
  background: rgba(238,228,218,0.35);
  border-radius: 8rpx;
}

/* 方块 */
.tile {
  position: absolute;
  inset: 0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  z-index: 1;
}
.tile-new {
  animation: popIn 0.2s ease;
}
.tile-merged {
  animation: popIn 0.2s ease;
}
@keyframes popIn {
  0% { transform: scale(0); }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* ========== 结果弹窗（胜利 / 失败） ========== */
.result-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.result-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
}
.result-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}
.result-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #776E65;
  margin-bottom: 8rpx;
}
.result-sub {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 32rpx;
}
.result-scores {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 24rpx 0;
  background: #F9F8F3;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}
.rs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rs-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 6rpx;
}
.rs-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #776E65;
}
.rs-value.best {
  color: #F59E0B;
}
.rs-divider {
  width: 2rpx;
  height: 52rpx;
  background: #E5E0D8;
}
.result-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
}
.result-btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}
.result-btn.restart-btn {
  background: #8F7A66;
  color: #FFFFFF;
}
.result-btn.continue-btn {
  background: #EDC22E;
  color: #FFFFFF;
}