/* pages/todo/todo.wxss —— 待办事项清单 */
.page {
  height: 100vh;
  background: #F5F6FA;
}

/* 顶部统计 */
.header {
  background: linear-gradient(160deg, #84CC16 0%, #65A30D 100%);
  padding: 40rpx 40rpx 72rpx;
  color: #FFFFFF;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 输入卡片 */
.input-card {
  margin: -40rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.08);
  position: relative;
  z-index: 1;
}

.input-bar {
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  font-size: 28rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.input-ph {
  color: #C4CAD4;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #84CC16;
  color: #FFFFFF;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-btn-hover {
  opacity: 0.8;
}

/* 优先级 */
.priority-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3F4F6;
}

.priority-chip {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #6B7280;
  background: #F9FAFB;
}

.priority-chip.on.high { background: #FEE2E2; color: #EF4444; font-weight: 700; }
.priority-chip.on.mid { background: #FEF3E3; color: #F59E0B; font-weight: 700; }
.priority-chip.on.low { background: #EAF2FE; color: #3B82F6; font-weight: 700; }

/* 筛选 */
.tabs {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 32rpx 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6B7280;
  background: #FFFFFF;
  border-radius: 999rpx;
}

.tab.active {
  background: #84CC16;
  color: #FFFFFF;
  font-weight: 600;
}

/* 清空已完成 */
.clear-done {
  margin: 8rpx 32rpx 0;
  text-align: right;
  font-size: 24rpx;
  color: #EF4444;
}

/* 列表 */
.list {
  padding: 16rpx 32rpx 60rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 41, 55, 0.04);
}

.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.check.checked {
  background: #84CC16;
  border-color: #84CC16;
}

.item-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
}

.item-title {
  font-size: 30rpx;
  color: #1F2937;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.p-tag {
  margin-left: 12rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.p-tag.p-high { background: #FEE2E2; color: #EF4444; }
.p-tag.p-mid { background: #FEF3E3; color: #F59E0B; }
.p-tag.p-low { background: #EAF2FE; color: #3B82F6; }

.item-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}

.item-reminder-label {
  font-size: 20rpx;
  color: #F59E0B;
  background: #FEF3E3;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

/* 提醒开关 */
.remind-toggle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  opacity: 0.4;
  margin-right: 4rpx;
}
.remind-toggle.on {
  opacity: 1;
}
.remind-toggle-hover {
  background: #FEF3E3;
}

.item.done .item-title {
  color: #9CA3AF;
  text-decoration: line-through;
}

.del {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D1D5DB;
  font-size: 30rpx;
  flex-shrink: 0;
}

.del-hover {
  background: #FEE2E2;
  color: #EF4444;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #6B7280;
  font-weight: 600;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9CA3AF;
}

/* 提醒弹窗 */
.remind-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999;
  background: rgba(0, 0, 0, 0.55);
  display: flex; align-items: center; justify-content: center;
}
.remind-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}
.remind-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.remind-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
}
.remind-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.4;
  margin-bottom: 32rpx;
}
.remind-btns {
  width: 100%;
}
.remind-btn {
  width: 100%;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}
.remind-btn.primary {
  background: linear-gradient(135deg, #84CC16, #65A30D);
  color: #FFFFFF;
}