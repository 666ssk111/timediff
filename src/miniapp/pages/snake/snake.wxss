/* pages/snake/snake.wxss —— 贪吃蛇 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

/* ========== 头部 ========== */
.hero {
  background: linear-gradient(160deg, #10B981 0%, #34D399 100%);
  padding: 4rpx 44rpx 40rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.hero-left { position: relative; z-index: 1; }
.hero-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.hero-title { font-size: 42rpx; font-weight: 700; }
.hero-desc { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.8); }

/* 头部中央得分 */
.hero-score {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
}
.hero-score-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}
.hero-score-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
}

/* 头部右侧排行榜按钮 */
.hero-rank-btn {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  border: 2rpx solid rgba(255,255,255,0.25);
  margin-top: 8rpx;
}
.rank-btn-icon { font-size: 36rpx; }
.rank-btn-text { font-size: 20rpx; color: #FFFFFF; font-weight: 600; margin-top: 2rpx; }
.rank-btn-hover { opacity: 0.75; transform: scale(0.94); }

.body { padding: 0 32rpx; margin-top: -0rpx; position: relative; z-index: 2; }

.score-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.06);
}
.score-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.score-label { font-size: 22rpx; color: #9CA3AF; }
.score-num { margin-top: 4rpx; font-size: 36rpx; font-weight: 800; color: #10B981; }

/* 游戏区 */
.board {
  position: relative;
  width: 700rpx;
  height: 700rpx;
  margin: 0 auto;
  background: #F0FDF4;
  border: 4rpx solid #D1FAE5;
  border-radius: 24rpx;
  overflow: hidden;
}
.food {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #EF4444;
}
.snake-seg {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #34D399;
  transition: none;
}
.snake-seg.head { background: #059669; }

.overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.overlay-btn {
  padding: 20rpx 56rpx;
  background: #10B981;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.ov-btn-hover { opacity: 0.85; }

/* ========== 方向键（调整后居中美观） ========== */
.pad {
  margin-top: 48rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pad-row { display: flex; gap: 150rpx; margin-bottom: 4rpx; }
.pad-btn {
  width: 150rpx;
  height: 130rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #10B981;
  font-weight: 700;
}
.pad-hover { opacity: 0.7; transform: scale(0.94); }

/* ========== 排行榜弹窗 ========== */
.rank-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: rankFadeIn 0.2s ease;
}
@keyframes rankFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.rank-popup {
  width: 580rpx;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  animation: rankSlideUp 0.25s ease;
}
@keyframes rankSlideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.rank-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}
.rank-popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}
.rank-popup-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9CA3AF;
}
.rank-close-hover { background: #E5E7EB; }

.rank-popup-list {
  padding: 16rpx 36rpx 32rpx;
  max-height: 56vh;
}

.rank-popup-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F9FAFB;
}
.rank-popup-item:last-child { border-bottom: none; }

.rank-popup-idx {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #6B7280;
  flex-shrink: 0;
}
.rank-popup-idx.rank-gold { background: #FEF3C7; color: #D97706; }
.rank-popup-idx.rank-first { background: #FFF7E0; color: #F59E0B; font-size: 32rpx; }
.rank-popup-idx.rank-second { background: #F0F4F8; color: #94A3B8; font-size: 32rpx; }
.rank-popup-idx.rank-third { background: #FEF2E8; color: #D97706; font-size: 32rpx; }

.rank-popup-score {
  margin-left: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.rank-popup-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9CA3AF;
}