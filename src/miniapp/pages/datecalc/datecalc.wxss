/* pages/datecalc/datecalc.wxss —— 日期计算 */
.page {
  min-height: 100vh;
  background: #F5F6FA;
  padding: 32rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
}

.card-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9CA3AF;
}

.field {
  margin-top: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #4B5563;
}

.picker {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  background: #F9FAFB;
  color: #1F2937;
  font-size: 30rpx;
}

.picker-ph {
  color: #9CA3AF;
}

.btn {
  margin-top: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.btn::after {
  border: none;
}

.btn-hover {
  opacity: 0.88;
}

.result {
  margin-top: 48rpx;
  padding: 32rpx;
  background: #EAF2FE;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-label {
  font-size: 24rpx;
  color: #3B82F6;
}

.result-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1D4ED8;
}
