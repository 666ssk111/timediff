/* pages/habit/habit.wxss —— 喝水打卡 + 日历历史 */
.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(160deg, #0EA5E9 0%, #38BDF8 100%);
  padding: 48rpx 40rpx 140rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.hero-icon { font-size: 72rpx; margin-bottom: 16rpx; position: relative; z-index: 1; }
.hero-title { font-size: 44rpx; font-weight: 700; position: relative; z-index: 1; }
.hero-desc { margin-top: 10rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.82); position: relative; z-index: 1; }

.body { padding: 0 32rpx; margin-top: -100rpx; position: relative; z-index: 2; }

/* 进度卡 */
.progress-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.06);
  text-align: center;
}
.cup-count {
  display: flex;
  align-items: baseline;
  justify-content: center;
}
.cup-num { font-size: 96rpx; font-weight: 800; color: #0EA5E9; line-height: 1; }
.cup-unit { font-size: 32rpx; color: #9CA3AF; margin-left: 8rpx; font-weight: 600; }
.cup-goal { margin-top: 8rpx; font-size: 26rpx; color: #9CA3AF; }

/* 进度条 */
.progress-track {
  margin-top: 32rpx;
  height: 20rpx;
  background: #E4F4FD;
  border-radius: 10rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0EA5E9, #38BDF8);
  border-radius: 10rpx;
  min-width: 0;
}
.progress-text { margin-top: 16rpx; font-size: 24rpx; color: #0EA5E9; font-weight: 600; }

/* 喝水按钮 */
.drink-btn {
  margin-top: 36rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #0EA5E9, #38BDF8);
  box-shadow: 0 16rpx 40rpx rgba(14, 165, 233, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  margin-right: auto;
  color: #FFFFFF;
}
.drink-btn-hover { transform: scale(0.94); opacity: 0.9; }
.drink-icon { font-size: 72rpx; line-height: 1; }
.drink-text { margin-top: 8rpx; font-size: 28rpx; font-weight: 700; }
.drink-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.85); margin-top: 4rpx; }

/* 连续天数 */
.streak-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}
.streak-icon { font-size: 48rpx; }
.streak-text { margin-left: 16rpx; font-size: 28rpx; color: #4B5563; }
.streak-num { font-size: 40rpx; font-weight: 800; color: #0EA5E9; margin: 0 6rpx; }

/* 近 7 天 */
.week-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.week-title { font-size: 28rpx; font-weight: 700; color: #1F2937; margin-bottom: 20rpx; }
.week-row { display: flex; justify-content: space-between; }
.week-day { flex: 1; display: flex; flex-direction: column; align-items: center; }
.wd-label { font-size: 22rpx; color: #9CA3AF; }
.wd-dot {
  margin-top: 12rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9CA3AF;
  background: #F3F4F6;
}
.wd-dot.has { background: #D6F0FF; color: #0EA5E9; font-weight: 700; }
.wd-dot.full { background: #0EA5E9; color: #FFFFFF; font-weight: 700; }
.wd-dot.today { border: 2rpx solid #0EA5E9; box-sizing: border-box; }

/* 历史记录按钮 */
.history-toggle {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}
.history-icon { font-size: 36rpx; }
.history-text { margin-left: 12rpx; font-size: 28rpx; color: #0EA5E9; font-weight: 600; }
.history-arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: #0EA5E9;
  transition: transform 0.3s;
  display: inline-block;
}
.history-arrow.up { transform: rotate(90deg); }

/* 日历卡片 */
.calendar-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}

/* 月份导航 */
.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.cal-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #0EA5E9;
  font-weight: 700;
}
.cal-nav-btn.disabled {
  opacity: 0.3;
  pointer-events: none;
}
.cal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

/* 星期标题 */
.cal-weekdays {
  display: flex;
  margin-bottom: 12rpx;
}
.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 600;
  padding: 8rpx 0;
}

/* 日期网格 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-day {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  position: relative;
}
.cal-day.empty { opacity: 0; pointer-events: none; }
.cal-day-num {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}
.cal-day.today {
  background: #E4F4FD;
}
.cal-day.today .cal-day-num {
  color: #0EA5E9;
  font-weight: 700;
}
.cal-day.has .cal-day-num {
  color: #0EA5E9;
}
.cal-day.full {
  background: #D6F0FF;
}
.cal-day.full .cal-day-num {
  color: #0EA5E9;
  font-weight: 700;
}
.cal-day.future .cal-day-num {
  color: #D1D5DB;
}
.cal-day.future {
  pointer-events: none;
}

/* 日期下的打卡指示点 */
.cal-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 4rpx;
}
.cal-dot.dot-has { background: #0EA5E9; }
.cal-dot.dot-full { background: #0284C7; }

/* 图例 */
.cal-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9CA3AF;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.legend-dot.dot-has { background: #D6F0FF; border: 2rpx solid #0EA5E9; }
.legend-dot.dot-full { background: #0EA5E9; }

/* 日详情弹窗 */
.day-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.day-detail-card {
  width: 520rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.day-detail-date {
  font-size: 28rpx;
  color: #9CA3AF;
  margin-bottom: 20rpx;
}
.day-detail-count {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}
.day-detail-num {
  font-size: 96rpx;
  font-weight: 800;
  color: #0EA5E9;
  line-height: 1;
}
.day-detail-unit {
  font-size: 32rpx;
  color: #9CA3AF;
  margin-left: 8rpx;
}
.day-detail-status {
  font-size: 28rpx;
  color: #4B5563;
  margin-bottom: 32rpx;
}
.day-detail-close {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 600;
}