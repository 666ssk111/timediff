# 统一换行符，避免 Windows / macOS / Linux 之间来回改动整个文件。
# 文本文件在仓库里一律存成 LF，检出时按平台自动转换。
* text=auto eol=lf

# 明确按文本处理的语言与配置
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.wxml  text eol=lf
*.wxss  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Windows 批处理必须保持 CRLF，否则可能无法执行
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做任何换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.ttf   binary
*.ttc   binary
*.otf   binary
*.woff  binary
*.woff2 binary

# 让 GitHub 把生成物识别为生成物，折叠 diff、排除语言统计
package-lock.json  linguist-generated=true
pnpm-lock.yaml     linguist-generated=true
docs/API.md        linguist-documentation=true
